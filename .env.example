# MySQL database. Use a managed MySQL service reachable from Vercel.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE?sslaccept=strict
# Generate a long random value (at least 32 characters) and keep it secret.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
APP_URL=https://your-vercel-domain.vercel.app
# Paystack: use test keys until checkout and webhook verification are tested.
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_PUBLIC_KEY=pk_test_replace_me
PAYSTACK_WEBHOOK_SECRET=replace_me
# Used only by the first-admin bootstrap script described in README.
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-random-secret-of-at-least-24-characters
