# MySQL database reachable from Vercel and your future hosting provider
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/veritas_autos"
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
APP_URL="http://localhost:3000"
PAYSTACK_SECRET_KEY="sk_test_replace_me"
PAYSTACK_PUBLIC_KEY="pk_test_replace_me"
# Optional: admin account created by prisma/seed.ts
ADMIN_EMAIL="admin@veritasautos.com"
ADMIN_PASSWORD="ChangeThisAdminPassword123!"
# Marketplace defaults. Commission is calculated server-side.
DEFAULT_COMMISSION_PERCENT="10"
MIN_WITHDRAWAL_NGN="1000"
